{
  "name": "SMEsAgent-hosting-service",
  "version": "1.0.0",
  "description": "Enterprise hosting service for published SMEsAgent applications (VPS4)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "test": "node test-hosting-local.js",
    "pm2:start": "pm2 start server.js --name SMEsAgent-hosting --node-args='--no-deprecation'",
    "pm2:stop": "pm2 stop SMEsAgent-hosting",
    "pm2:restart": "pm2 restart SMEsAgent-hosting"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "dns2": "^2.1.0"
  }
}
