  "cards": [
    {
      "dot": "cyan",
      "title": "One codebase, two roles",
      "items": [
        "SERVICE_ROLE splits api-gateway into api and gen",
        "VPS3 mounts only /api/v1/ai, in two cluster workers",
        "Redis carries the project lock and cross-worker run streams",
        "A run started on one worker stays readable from the other"
      ]
    },
    {
      "dot": "rose",
      "title": "Three hops, one shared secret",
      "items": [
        "File push, credential sync and build check all gate on PREVIEW_UPDATE_SECRET",
        "A mismatch 401s all three at once, logged only as a warning",
        "The generated app reaches its database directly, not via the platform",
        "Auth and tenant data deliberately live on different hosts"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where state can diverge",
      "items": [
        "Project files exist on VPS3 disk and again on VPS2",
        "Credentials exist in the platform DB and again in .env.local",
        "Nothing reconciles either pair after a push",
        "Every incident this month was a divergence between two copies"
      ]
    }
  ]
